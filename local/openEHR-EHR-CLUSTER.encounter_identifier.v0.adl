definition
	CLUSTER[at0000] matches {    -- Encounter_identifier
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Encounter identifier
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

